# Brabo template configuration — placeholders only; never commit .env.
PAYLOAD_SECRET=replace-with-a-long-random-secret
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# DYAD_DISABLE_DB_PUSH is the existing compatibility switch; not a network destination.
DYAD_DISABLE_DB_PUSH=false
# Optional Gmail delivery. Use your own account/app password.
GMAIL_USER=
GOOGLE_APP_PASSWORD=
EMAIL_DEFAULT_FROM_NAME=Brabo app
